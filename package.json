{
  "name": "scraper-ong",
  "version": "1.0.0",
  "description": "Web scraper for WePrope oportunidades using Hono and Playwright",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "scrape": "node dist/scrapers/runner.js",
    "lint": "eslint src/**/*.ts",
    "format": "prettier --write src/**/*.ts",
    "test": "vitest",
    "type-check": "tsc --noEmit"
  },
  "keywords": [
    "scraper",
    "playwright",
    "hono",
    "google-sheets"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@hono/node-server": "^1.13.0",
    "axios": "^1.6.0",
    "dotenv": "^16.3.1",
    "hono": "^4.0.0",
    "pino": "^8.17.2",
    "pino-pretty": "^10.3.1",
    "playwright": "^1.40.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "eslint": "^8.54.0",
    "prettier": "^3.1.0",
    "tsx": "^4.21.0",
    "typescript": "^5.3.2",
    "vitest": "^1.0.0"
  }
}
